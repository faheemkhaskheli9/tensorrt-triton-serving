{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TRT Serving: export sample model to ONNX",
      "type": "debugpy",
      "request": "launch",
      "module": "trt_serving",
      "args": ["export", "--output", "models/tiny_classifier.onnx", "--opset", "17"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "TRT Serving: export (static batch, 64x64)",
      "type": "debugpy",
      "request": "launch",
      "module": "trt_serving",
      "args": [
        "export", "--output", "models/tiny_64.onnx",
        "--input-shape", "1x3x64x64", "--static-batch"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "TRT Serving: pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
